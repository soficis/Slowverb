# Slowverb ignore rules

# JavaScript/TypeScript dependencies and build outputs
node_modules/
web/node_modules/
web/packages/**/dist/
web/playwright-report/
web/blob-report/
.eslintcache

# Flutter/Dart build outputs
.dart_tool/
.flutter_sdk/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
.packages
.pub/
.pub-cache/
build/
web/build/

# Native build artifacts
*.exe
*.dll
*.so
*.dylib
*.js.mem

# Ignore generated wasm by default, but keep deploy assets under web/web/js
*.wasm
!web/web/js/*.wasm
!web/web/js/vendor/*.wasm

# Source maps/logs/temp
*.js.map
*.log
logs/
.cache/
*.tmp
*.temp
*.bak
*.orig
*.rej

# IDE/OS clutter
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Test outputs (tests themselves are versioned)
coverage/
*.lcov
web/test-results/

# Environment/secrets
*.env
.env.*
secrets/
credentials/

# Generated diagnostics
**/analysis_*.txt
**/app_analyze.txt
**/test_output.txt
**/test.json
lints.txt
lints_utf8.txt

# Local agent temp markers
tmpclaude-*-cwd
**/tmpclaude-*-cwd
.codegraph/
.omo/


# Documentation (ignored by request)
docs/

# PhaseLimiter third-party vendored source; fetch separately when needed
wasm/phaselimiter/src_original/
wasm/phaselimiter/build_*.txt
wasm/phaselimiter/build_*.log
wasm/phaselimiter/conv_*.txt
wasm/phaselimiter/test*.wasm
wasm/phaselimiter/test*.js
wasm/phaselimiter/test_sizes*

# Optional local archive of phaselimiter source bundle
wasm/phaselimiter/phaselimiter.zip
